{
  "name": "discordbot",
  "version": "1.0.0",
  "description": "LinBot — Barlog Family Discord 伺服器的九尾靈狐機器人",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
