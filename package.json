    "dotenv": "^17.3.1",
    "mongodb": "^7.1.1",
    "node-fetch": "^3.3.2",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "@vitest/coverage-v8": "3.2.7",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "^3.2.0"
  }
}